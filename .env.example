# Copiar a .env (fuera de control de versiones) y rellenar valores reales.
# Nunca commitear secretos.
# Usado por docker-compose.yml para postgres, backend y frontend.

POSTGRES_DB=timetracking
POSTGRES_USER=timetracking
POSTGRES_PASSWORD=changeme
JWT_SECRET=replace-with-at-least-32-bytes-secret
FRONTEND_ORIGIN=http://localhost:4200
AUTH_REFRESH_COOKIE_SECURE=false
# Enlace del correo de recuperacion de contrasena (RF-USR-006). Si se deja
# vacio se deriva de FRONTEND_ORIGIN. Debe conservar un unico %s: ahi va el
# token de un solo uso.
AUTH_PASSWORD_RESET_URL_TEMPLATE=
APP_REQUEST_MAX_PAYLOAD_BYTES=65536

# PLATFORM_ADMIN inicial (T50-04). Si se dejan vacios no se crea ninguno.
# La contrasena es un secreto: no commitear .env con valores reales.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Registro publico autoservicio (RF-TEN-010). Habilitado por defecto: cada
# solicitud sigue exigiendo verificacion de correo y aprobacion de un
# PLATFORM_ADMIN antes de que exista ningun tenant. Ponerlo a false cierra el
# alta publica y deja el alta de tenants como una operacion exclusiva de
# PLATFORM_ADMIN.
PUBLIC_REGISTRATION_ENABLED=true
# Enlace del correo de verificacion del alta (RF-REG-004). Si se deja vacio se
# deriva de FRONTEND_ORIGIN. Debe conservar un unico %s: ahi va el token.
REGISTRATION_VERIFICATION_URL=

# Correo saliente (T110-01, ADR-0012). En desarrollo apunta a mailpit, que
# captura los mensajes en http://localhost:8025 en vez de entregarlos.
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@timetracking.local
