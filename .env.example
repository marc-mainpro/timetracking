# Copiar a .env (fuera de control de versiones) y rellenar valores reales.
# Nunca commitear secretos.
# Usado por docker-compose.yml para postgres, backend y frontend.

POSTGRES_DB=timetracking
POSTGRES_USER=timetracking
POSTGRES_PASSWORD=changeme
JWT_SECRET=replace-with-at-least-32-bytes-secret
FRONTEND_ORIGIN=http://localhost:4200
AUTH_REFRESH_COOKIE_SECURE=false
APP_REQUEST_MAX_PAYLOAD_BYTES=65536

# PLATFORM_ADMIN inicial (T50-04). Si se dejan vacios no se crea ninguno.
# La contrasena es un secreto: no commitear .env con valores reales.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
