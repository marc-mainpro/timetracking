# Plantilla de la configuración de nginx. El entrypoint de la imagen la pasa por
# envsubst al arrancar y escribe el resultado en /etc/nginx/conf.d/default.conf.
#
# La única variable sustituida es ${BACKEND_ORIGIN} (esquema + host + puerto del
# backend), porque ese dato solo se conoce en el despliegue: en docker-compose es
# el nombre del servicio por HTTP y en Render puede ser una URL pública por
# HTTPS. La compone 19-backend-origin.envsh, que además acepta la variable
# antigua BACKEND_HOSTPORT. El filtro NGINX_ENVSUBST_FILTER del Dockerfile impide
# que envsubst se coma las variables propias de nginx ($host, $uri, $scheme…).

# Caché por tipo de recurso. Va en un `map` y no en `add_header` dentro de cada
# `location` porque nginx no hereda las cabeceras del bloque superior en cuanto
# un `location` añade la suya: hacerlo así dejaría el index sin CSP ni el resto
# de cabeceras de seguridad.
#
# El index no se puede cachear: no lleva hash en el nombre, así que un navegador
# con la copia vieja seguiría pidiendo los bundles antiguos y no vería el
# despliegue nuevo —le pasó a una versión que ya estaba servida—. `no-cache` no
# prohíbe guardarlo, solo obliga a revalidar, de modo que el 304 sigue ahorrando
# la descarga. Los bundles sí llevan hash en el nombre, y por eso son inmutables.
map $uri $cache_control {
  default                                          "no-cache";
  ~*\.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$  "public, max-age=31536000, immutable";
}

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 64k;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript application/xml+rss image/svg+xml;

  add_header Cache-Control $cache_control always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

  location /api/ {
    proxy_pass ${BACKEND_ORIGIN}/api/;
    proxy_http_version 1.1;

    # Host tiene que ser el del backend, no el del navegador ($host). Los
    # servicios gestionados (Render, Fly…) enrutan por Host: mandarles el del
    # frontend devuelve 404 de su router, sin llegar a la aplicación. $proxy_host
    # lo saca del propio proxy_pass, así que no hay una segunda variable que
    # mantener en sincronía. El backend no lee esta cabecera para nada.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Necesario cuando el upstream es HTTPS: sin SNI el balanceador del
    # proveedor no sabe qué certificado servir y el handshake falla.
    proxy_ssl_server_name on;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
