#!/bin/sh
# Normaliza el destino del proxy_pass antes de que corra envsubst.
#
# El entrypoint de nginx recorre /docker-entrypoint.d/ en orden: este fichero va
# con el 19 para ejecutarse justo antes de 20-envsubst-on-templates.sh, y acaba
# en .envsh (no .sh) porque tiene que exportar BACKEND_ORIGIN al mismo shell que
# luego llama a envsubst. Necesita el bit de ejecución o el entrypoint lo ignora
# en silencio.
#
# Existe porque hay dos formas de decir dónde está el backend y ninguna sirve
# para los dos despliegues:
#
#   BACKEND_ORIGIN=https://api.ejemplo.com   origen completo con esquema
#   BACKEND_HOSTPORT=backend:8080            solo host:puerto
#
# La segunda es la que dan las plataformas gestionadas que exponen el servicio
# como "host:puerto" sin esquema y no permiten concatenar nada. La primera es
# imprescindible desde que el backend puede ser un servicio público por HTTPS:
# ahí el esquema no es deducible del puerto en todos los casos y suponer http://
# hace que el router del proveedor responda 400.

# Las expansiones llevan :- a propósito. El script se ejecuta con `set -u`
# heredado de 15-local-resolvers.envsh, que el entrypoint sourcea antes que este
# en el mismo shell: sin el defecto, leer una variable no definida aborta el
# script entero y la plantilla se queda sin procesar, dejando la default.conf de
# serie de nginx y un frontend que sirve la página de bienvenida.
if [ -n "${BACKEND_ORIGIN:-}" ]; then
    :
elif [ -n "${BACKEND_HOSTPORT:-}" ]; then
    case "${BACKEND_HOSTPORT}" in
        # Ya trae esquema: alguien puso una URL entera en la variable vieja.
        # Se acepta en vez de romper con "http://https://…".
        http://*|https://*) BACKEND_ORIGIN="${BACKEND_HOSTPORT}" ;;
        # El 443 solo se usa para TLS: asumir http ahí es siempre un error.
        *:443)              BACKEND_ORIGIN="https://${BACKEND_HOSTPORT}" ;;
        *)                  BACKEND_ORIGIN="http://${BACKEND_HOSTPORT}" ;;
    esac
else
    echo "ERROR: falta BACKEND_ORIGIN (o BACKEND_HOSTPORT). Sin destino al que" >&2
    echo "       reenviar /api/, nginx no puede arrancar. Ejemplos:" >&2
    echo "         BACKEND_ORIGIN=https://api.ejemplo.com" >&2
    echo "         BACKEND_HOSTPORT=backend:8080" >&2
fi

# Quita la barra final y los puertos por defecto. Sin esto quedaría un
# proxy_pass con "//api/", y el Host que se manda arriba llevaría ":443"
# pegado, que algunos routers gestionados no reconocen.
BACKEND_ORIGIN=$(printf '%s' "${BACKEND_ORIGIN:-}" | sed \
    -e 's#/*$##' \
    -e 's#^https://\(.*\):443$#https://\1#' \
    -e 's#^http://\(.*\):80$#http://\1#')

export BACKEND_ORIGIN
echo "$0: el proxy /api/ apunta a ${BACKEND_ORIGIN}"
