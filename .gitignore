# IDE
.idea/
.vscode/
*.iml

# Entorno. El patrón es amplio a propósito: cualquier fichero que acabe en .env
# puede llevar credenciales reales (DB_PASSWORD, JWT_SECRET, MAIL_PASSWORD…), y
# los volcados de variables que exportan las plataformas de despliegue traen
# nombres imprevisibles (timetracking-backend_latest.env). Enumerar nombres uno
# a uno ya dejó fuera alguno.
# Las plantillas .env.example sí van versionadas: se exceptúan explícitamente.
.env
.env.*
*.env
!.env.example
!*.env.example

# SO
.DS_Store
Thumbs.db

# Logs
*.log

# LibreOffice
.~lock.*#

# Eclipse
.classpath
.project
.settings/

# Informes de escaneo de seguridad (T30-05)
security-reports/

# Backups locales de PostgreSQL (T150)
backups/

# Worktrees de agentes (trabajo en paralelo de la V2)
.claude/worktrees/
